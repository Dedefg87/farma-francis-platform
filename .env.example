# Variáveis de ambiente para o Farma Francis Platform

# URL pública do R2.dev para servir mídias (imagens, PDFs, etc.)
# IMPORTANTE: Esta URL deve apontar para o bucket público do R2
VITE_PUBLIC_R2_URL=https://pub-33c481f0a9e94adb8870472308f49471.r2.dev

# Cloudflare R2 / S3 Compatible (JÁ CONFIGURADO NO RAILWAY)
# Estas variáveis são usadas para upload direto de arquivos (broadcast, mídias)
S3_ENDPOINT=s3.us-east-1.amazonaws.com  # exemplo: sua-region.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=auto  # ou a região específica (ex: us-east-1)

# Outras variáveis (já configuradas no Railway):
# - DATABASE_URL
# - JWT_SECRET
# - NODE_ENV=production
